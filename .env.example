# Anima — .env (Vorlage)
# Kopieren:  cp .env.example .env  — dann Werte anpassen.
# Diese Datei enthält den Secret-Key: NIE committen (.env liegt in .gitignore).

# --- Web ---
# 8080 (Höhle hat auf 8000 schon die OpenClaw-Gateway)
ANIMA_WEB_PORT=8080
DJANGO_DEBUG=false
# ZWINGEND, wenn DJANGO_DEBUG=false. Erzeugen:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=***
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
GUNICORN_WORKERS=2

# --- Daten (Volume: anima_data) ---
SQLITE_PATH=/data/anima.db
CHROMA_PATH=/data/chroma

# --- Redis (intern im Compose-Netz) ---
REDIS_URL=redis://redis:6379/0

# --- LLM (nur für Live-Chat relevant, nicht für Migrations/Healthcheck) ---
# Hinweis: iai-llm.iai.kit.edu ist nur im KIT-Netz erreichbar (Tailscale/KIT-WLAN).
# Ohne erreichbaren LLM bleibt der Chat träge, der Rest läuft.
LLM_BASE_URL=https://ki-toolbox.scc.kit.edu/api/v1
LLM_MODEL=kit.mistral-small-4-119b-a8b
LLM_API_KEY=
KIT_API_KEY=

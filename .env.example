# Anima-Umgebungsvariablen — nach `.env` kopieren und füllen.
# `.env` selbst wird nicht getrackt (siehe .gitignore).

# --- Django ---
# Wird ab der Secrets-Migration von settings.py gelesen.
# Generieren: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# --- LLM (OpenAI-kompatible API: vLLM, Ollama, ki-toolbox, ...) ---
# Optional: ohne Werte greifen die eingebauten ki-toolbox-Defaults.
LLM_BASE_URL=https://ki-toolbox.scc.kit.edu/api/v1
LLM_MODEL=kit.mistral-small-4-119b-a8b
# Der Code prüft zuerst KIT_API_KEY, dann LLM_API_KEY.
KIT_API_KEY=
# LLM_API_KEY=

# --- Embeddings (ChromaDB) ---
# BGE-m3 wird beim ersten Start geladen; ChromaDB-Verzeichnis ist
# hartkodiert unter ~/.hermes/chroma/anima (memory/services.py).
